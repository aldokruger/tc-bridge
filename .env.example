# Copie para ".env" na maquina de upgrade e preencha os valores.
# Gere um token forte:  python -c "import secrets; print(secrets.token_urlsafe(48))"
TC_TOKEN=troque-por-um-token-forte-e-aleatorio
TC_PORT=4100

# Leitura: obrigatorio. Restrinja aos diretorios de trabalho necessarios.
TC_ALLOWED_READ_PATHS=D:\\upgrade;D:\\logs

# Escrita (opcional): descomente para permitir.
# TC_ALLOW_WRITE=1
# TC_ALLOWED_WRITE_PATHS=D:\upgrade;D:\logs

# Diagnosticos PowerShell (opcional). Nao aceita comandos arbitrarios.
# TC_ALLOW_DIAGNOSTICS=1
# TC_DIAGNOSTIC_HOSTS=localhost;127.0.0.1;::1

# Diagnosticos MSSQL somente leitura (opcional). Use uma conta dedicada de minimo privilegio.
# Nunca envie esta senha ao cliente MCP nem a registre em logs.
# TC_ALLOW_DB_DIAGNOSTICS=1
# TC_DB_SERVER=172.18.2.51
# TC_DB_PORT=1433
# TC_DB_NAME=tc_DEV_2026
# TC_DB_USER=tc_bridge_diagnostic
# TC_DB_PASSWORD=<segredo-fornecido-pelo-DBA>
# TC_DB_ENCRYPT=true
# TC_DB_TRUST_SERVER_CERTIFICATE=false

# Consultas Teamcenter SOA somente leitura (opcional).
# A conta deve ser exclusiva, com permissao minima e sem capacidade de manutencao.
# TC_ALLOW_TEAMCENTER_READ=1
# TC_TEAMCENTER_URL=http://localhost:8080/tc
# TC_TEAMCENTER_USER=tc_bridge_reader
# TC_TEAMCENTER_PASSWORD=<segredo-fornecido-pelo-administrador>
# TC_TEAMCENTER_GROUP=<grupo-opcional>
# TC_TEAMCENTER_ROLE=<role-opcional>
# TC_TEAMCENTER_LOCALE=en_US
# TC_TEAMCENTER_JAVA=E:\PLM\JAVA_JRE\bin\java.exe
# TC_TEAMCENTER_SOA_LIB=E:\PLM\Teamcenter2606\TcFTSIndexer\lib
# JARs extras exigidos pelo cliente SOA, separados por ; (por exemplo, Log4j).
# TC_TEAMCENTER_SOA_EXTRA_JARS=E:\PLM\Teamcenter2606\tccs\third_party\log4j2\2.25.3\log4j-api-2.25.3.jar;E:\PLM\Teamcenter2606\tccs\third_party\log4j2\2.25.3\log4j-core-2.25.3.jar
# TC_TEAMCENTER_SOA_ADAPTER_JAR=E:\PLM\tc-bridge\tc-bridge-soa-adapter.jar

# Diagnosticos Chrome DevTools somente leitura (opcional).
# O Chrome deve ser iniciado localmente com --remote-debugging-port=9222.
# Nunca exponha a porta 9222 via tunnel, NAT ou firewall.
# TC_ALLOW_BROWSER_DIAGNOSTICS=1
# TC_BROWSER_DEVTOOLS_URL=http://127.0.0.1:9222

# Tunel (opcional): localtunnel (padrao) | static
# TC_TUNNEL=localtunnel
# TC_PUBLIC_URL=https://seu-dominio-publico.example
